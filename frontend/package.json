{
  "name": "seeword-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/ e2e/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "check": "node scripts/check-design-system.mjs && node scripts/check-session-writes.mjs && npm run typecheck && npm run lint && npm run format:check",
    "precommit": "npm run check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "clsx": "^2.1.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.44.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
