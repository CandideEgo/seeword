# Copy OUTSIDE the repository (for example ~/.seeword/selfhost.env).
# Sole installation instructions: docs/self-hosting.md
COMPOSE_PROJECT_NAME=seeword-selfhost
# Generate three independent secrets: openssl rand -hex 32
# Hex avoids URL-encoding mistakes in DATABASE_URL / REDIS_URL.
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
DB_NAME=seeword
SITE_URL=https://localhost:19443
HTTPS_PORT=19443
# Absolute path containing fullchain.pem and privkey.pem; no private key in git.
SSL_CERT_DIR=

# Explicit model-free base. These are not authentication bypasses.
LLM_ENABLED=false
CONTENT_PRODUCTION_ENABLED=false
# Pilot defaults stay closed. Enable only after configuring receipt verification
# and completing the local schema/import/review/sign/publish drill.
SLCS_LESSONS_ENABLED=false
SLCS_VOCABULARY_ENABLED=false
SLCS_LESSON_RECEIPT_ISSUER=
SLCS_LESSON_RECEIPT_PUBLIC_KEYS={}

# Optional model/video production is a separate operator decision; see the guide.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
COMMANDCODE_API_KEY=
TRANSCRIPTION_CALLBACK_SECRET=
TRANSCRIPTION_CALLBACK_URL=
